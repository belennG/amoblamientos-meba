---
import Section from './Section.astro';
import Reveal from './Reveal.astro';
import { whatsappUrl } from '../data/site';

const wa = whatsappUrl(
  'Hola MEBA, quiero un render 3D sin cargo y un presupuesto para mi farmacia.',
);
---

<Section id="renders" variant="panel-2">
  <div class="container-x grid">
    <Reveal as="article" class="bloque">
      <p class="kicker">Diseño 3D</p>
      <h2>Renders sin cargo</h2>
      <p>
        Antes de fabricar nada te mostramos cómo va a quedar tu farmacia. Preparamos los diseños y
        renders en 3D <strong>sin costo y sin compromiso</strong>: los revisás, pedís cambios y
        recién ahí avanzamos con el presupuesto final.
      </p>
      <a class="btn btn-wa" href={wa} target="_blank" rel="noopener">
        Pedir mi render por WhatsApp
      </a>
    </Reveal>

    <Reveal class="col-img" delay={120}>
      <img
        src="/images/brand/render-ejemplo.png"
        alt="Ejemplo de render 3D de un salón de farmacia con mostradores y estanterías propuestos"
        width="1069"
        height="750"
        loading="lazy"
      />
    </Reveal>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  :global(#renders .col-img) img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--color-line);
  }
  /* .bloque is rendered by <Reveal as="article">, so it never carries this
     component's scope attribute — :global() is required for it to match. */
  :global(#renders .bloque) h2 {
    font-size: clamp(1.8rem, 4.4vw, 2.6rem);
    margin: 1rem 0 1.5rem;
  }
  :global(#renders .bloque) p {
    color: var(--color-muted);
    max-width: 46ch;
    margin: 0 0 2.2rem;
  }
  :global(#renders .bloque) strong {
    color: var(--color-cream);
    font-weight: 500;
  }
</style>
