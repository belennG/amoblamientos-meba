  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" fill="currentColor">
    <path
      d="M16.01 3.2A12.76 12.76 0 0 0 3.2 15.94c0 2.24.59 4.43 1.71 6.36L3.09 28.8l6.68-1.75a12.77 12.77 0 0 0 6.24 1.59h.01A12.76 12.76 0 0 0 28.8 15.95 12.7 12.7 0 0 0 16.01 3.2Zm0 23.06h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-3.96 1.04 1.06-3.86-.25-.4a10.55 10.55 0 0 1-1.62-5.65 10.58 10.58 0 0 1 18.07-7.48 10.5 10.5 0 0 1 3.11 7.5 10.6 10.6 0 0 1-10.6 10.57Zm5.8-7.92c-.32-.16-1.88-.93-2.17-1.03-.29-.11-.5-.16-.72.16-.21.32-.82 1.03-1 1.24-.19.21-.37.24-.68.08-.32-.16-1.34-.5-2.56-1.58-.94-.84-1.58-1.88-1.77-2.2-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55l-.61-.01c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.66 0 1.57 1.14 3.08 1.3 3.29.16.21 2.25 3.43 5.44 4.81.76.33 1.35.52 1.81.67.76.24 1.46.21 2.01.13.61-.09 1.88-.77 2.15-1.51.27-.74.27-1.38.19-1.51-.08-.13-.29-.21-.61-.37Z"
    ></path>
  </svg>
</a>

<style>
  .wa {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 999px;
    background: #25d366;
    color: #05230f;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transition: transform 0.25s ease;
  }
  .wa:hover {
    transform: scale(1.06);
  }
  @media (min-width: 640px) {
    .wa {
      right: 1.6rem;
      bottom: 1.6rem;
      width: 3.7rem;
      height: 3.7rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa:hover {
      transform: none;
    }
  }
</style>
