---
import Section from './Section.astro';
import Reveal from './Reveal.astro';
import { site, whatsappUrl } from '../data/site';
---

<Section id="contacto" variant="panel">
  <div class="container-x grid">
    <Reveal class="intro">
      <p class="overline">Contacto</p>
      <h2>Contanos sobre tu farmacia</h2>
      <p class="lead">
        Escribinos y coordinamos una visita o una videollamada para relevar tu local. Para una
        respuesta más rápida, llamanos o mandanos un WhatsApp.
      </p>

      <ul class="datos">
        <li>
          <span>WhatsApp</span>
          <a href={whatsappUrl()} target="_blank" rel="noopener">+54 9 351 286-7538</a>
        </li>
        <li>
          <span>Email</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span>Taller</span>
          <p>{site.ciudad}, {site.provincia}</p>
        </li>
        <li>
          <span>Redes</span>
          <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
        </li>
      </ul>
    </Reveal>

    <Reveal class="form-wrap" delay={120}>
      <form
        name="contacto"
        method="POST"
        action="/gracias"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hp">
          <label>No completar este campo: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="row">
          <label class="field">
            <span>Nombre y apellido</span>
            <input type="text" name="nombre" required autocomplete="name" />
          </label>
          <label class="field">
            <span>Farmacia</span>
            <input type="text" name="farmacia" autocomplete="organization" />
          </label>
        </div>

        <div class="row">
          <label class="field">
            <span>Localidad y provincia</span>
            <input type="text" name="localidad" autocomplete="address-level2" />
          </label>
          <label class="field">
            <span>Teléfono</span>
            <input type="tel" name="telefono" autocomplete="tel" />
          </label>
        </div>

        <label class="field">
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label class="field">
          <span>¿Qué necesitás?</span>
          <textarea
            name="mensaje"
            rows="4"
            placeholder="Contanos si es una farmacia nueva o una reforma, medidas aproximadas del local, plazos…"
          ></textarea>
        </label>

        <label class="check">
          <input type="checkbox" name="matriculado" value="si" />
          <span>Soy farmacéutico/a matriculado/a y quiero consultar por convenios de mi Colegio.</span>
        </label>

        <button type="submit" class="btn btn-solid">Enviar consulta</button>
      </form>
    </Reveal>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0.6rem 0 1.2rem;
  }
  .lead {
    color: var(--color-muted);
    max-width: 42ch;
  }
  .datos {
    list-style: none;
    padding: 0;
    margin: 2.4rem 0 0;
    display: grid;
    gap: 1.3rem;
  }
  .datos li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .datos span {
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .datos a,
  .datos p {
    color: var(--color-cream);
    text-decoration: none;
    margin: 0;
  }
  .datos a:hover {
    color: var(--color-gold);
  }
  .datos li a + a {
    margin-top: 0.15rem;
  }

  form {
    display: grid;
    gap: 1.1rem;
  }
  .row {
    display: grid;
    gap: 1.1rem;
  }
  @media (min-width: 560px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field span {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  input,
  textarea {
    font: inherit;
    color: var(--color-cream);
    background: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: 2px;
    padding: 0.75rem 0.85rem;
    transition: border-color 0.25s;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-gold);
  }
  textarea {
    resize: vertical;
  }
  .check {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .check input {
    margin-top: 0.2rem;
    accent-color: var(--color-gold);
  }
  form .btn {
    justify-self: start;
    margin-top: 0.4rem;
  }
  .hp {
    position: absolute;
    left: -5000px;
  }
</style>
