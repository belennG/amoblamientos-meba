---
import Section from './Section.astro';
import Reveal from './Reveal.astro';

const hitos = [
  { dato: 'Bragado', detalle: 'Taller y fabricación · Provincia de Buenos Aires' },
  { dato: 'Todo el país', detalle: 'Coordinamos flete e instalación donde estés' },
];
---

<Section id="cobertura" variant="ink">
  <div class="container-x grid">
    <Reveal class="col-text">
      <p class="kicker">Cobertura nacional</p>
      <h2>Estamos en Bragado y llegamos a toda la Argentina</h2>
      <p class="lead">
        Fabricamos en nuestro taller de Bragado y nos encargamos de la logística hasta la puerta de tu
        farmacia. Ya instalamos mobiliario en la Provincia de Buenos Aires y en el interior del país;
        organizamos cada envío para que el mueble llegue en fecha y se arme en el lugar.
      </p>

      <div class="hitos">
        {
          hitos.map((h, i) => (
            <Reveal class="hito" delay={i * 90}>
              <span class="hito__dato">{h.dato}</span>
              <span class="hito__detalle">{h.detalle}</span>
            </Reveal>
          ))
        }
      </div>
    </Reveal>

    <Reveal class="col-img" delay={120}>
      <img
        src="/images/brand/flete-01.jpg"
        alt="Camión de Amoblamientos MEBA entregando mobiliario junto al cartel de acceso a El Colorado, Formosa"
        width="1290"
        height="972"
        loading="lazy"
      />
    </Reveal>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0.6rem 0 1.3rem;
    max-width: 24ch;
  }
  .lead {
    color: var(--color-muted);
    max-width: 54ch;
    margin: 0;
  }
  :global(#cobertura .col-img) img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--color-line);
  }
  .hitos {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(2, 1fr);
  }
  /* .hito is rendered by <Reveal>, so it never carries this component's
     scope attribute — :global() is required for it to match. */
  :global(#cobertura .hito) {
    border-left: 2px solid var(--color-gold);
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .hito__dato {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--color-cream);
  }
  .hito__detalle {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
