---
interface Props {
  id?: string;
  variant?: 'ink' | 'panel' | 'panel-2';
  class?: string;
}
const { id, variant = 'ink', class: className = '' } = Astro.props;
const bg = { ink: 'var(--color-ink)', panel: 'var(--color-panel)', 'panel-2': 'var(--color-panel-2)' }[variant];
---

<section id={id} class:list={['sec', className]} style={`background:${bg}`}>
  <slot />
</section>

<style>
  .sec {
    position: relative;
    padding-block: clamp(4.5rem, 12vw, 9rem);
    border-top: 1px solid var(--color-line);
  }
</style>
